# ==============================================================================
# eLab.am — LARAVEL BACKEND PRODUCTION TEMPLATE (.env.example)
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' on your production server.
# 2. Set APP_ENV=production, APP_DEBUG=false, and generate APP_KEY (php artisan key:generate).
# 3. Configure production MySQL credentials and HTTPS domains.
# 4. NEVER commit real secrets or credentials to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
APP_NAME="eLab.am API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.elab.am

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MySQL)
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=elab_production_db
DB_USERNAME=elab_db_user
DB_PASSWORD=

# ------------------------------------------------------------------------------
# 3. CORS & SANCTUM SPA AUTHENTICATION
# ------------------------------------------------------------------------------
FRONTEND_URL=https://elab.am
SANCTUM_STATEFUL_DOMAINS=elab.am,www.elab.am

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

# ------------------------------------------------------------------------------
# 4. LOGGING & CACHE
# ------------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# ------------------------------------------------------------------------------
# 5. MAIL / CONTACT NOTIFICATIONS
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@elab.am"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# 6. INITIAL SUPER ADMIN SEED CREDENTIALS
# ------------------------------------------------------------------------------
ADMIN_EMAIL="admin@elab.am"
ADMIN_PASSWORD=
